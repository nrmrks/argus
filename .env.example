# ARGUS configuration. Copy to .env and fill in your values:
#   cp .env.example .env && chmod 600 .env
# .env holds secrets and is git-ignored. Never commit it.
# scripts/render.py turns this file + n8n/workflows/*.json into build/.

# ---------------------------------------------------------------- n8n
# Public URL of n8n as seen from the Wazuh manager (no trailing slash).
N8N_PUBLIC_URL=http://n8n.example.internal:5678
# Timezone for n8n (IANA name).
TZ=UTC
# Webhook path for Wazuh alerts. Leave empty: render.py generates a random one
# and writes it back here.
WEBHOOK_PATH=
# Shared secret sent by Wazuh in the X-Wazuh-Secret header. Leave empty:
# render.py generates a strong random value and writes it back here.
WEBHOOK_SECRET=

# ---------------------------------------------------------------- Postgres
# Defaults match the bundled docker-compose Postgres service (host "postgres").
# For an external server put its host/port and an existing database/role.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=argus
POSTGRES_USER=argus
POSTGRES_PASSWORD=change-me

# ---------------------------------------------------------------- LLM
# OpenAI-compatible server. LM Studio is the tested option: its native
# /api/v0 endpoint returns TTFT and tokens/s, which ARGUS logs as metrics.
# Base URL WITHOUT /v1, reachable from the n8n container.
LLM_BASE_URL=http://llm-host.example.internal:1234
# API token if your server requires one (LM Studio: Developer > API tokens).
LLM_API_KEY=lm-studio
# Model identifier exactly as the server lists it (GET /v1/models).
LLM_MODEL=qwen/qwen3.5-9b
# Free-text label stored with every metrics row (useful when comparing GPUs).
HARDWARE_LABEL=my-gpu / LM Studio

# ---------------------------------------------------------------- Wazuh
# Indexer (OpenSearch) and Server API, reachable from n8n.
WAZUH_INDEXER_URL=https://wazuh.example.internal:9200
WAZUH_INDEXER_USER=argus_reader
WAZUH_INDEXER_PASSWORD=change-me
WAZUH_API_URL=https://wazuh.example.internal:55000
WAZUH_API_USER=argus_api
WAZUH_API_PASSWORD=change-me

# ---------------------------------------------------------------- optional
# n8n data table IDs (create the tables in the n8n UI, see docs/INSTALL.md).
# Empty = the nodes that use them are disabled on render.
METRICS_TABLE_ID=
BENCH_CASES_TABLE_ID=
# Delivery (nodes ship disabled; enable them in n8n when ready).
ALERT_EMAIL=
JIRA_PROJECT_ID=
JIRA_ISSUE_TYPE_ID=
